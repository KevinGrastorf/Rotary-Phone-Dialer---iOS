    "The app collects no information from anyone, including children under 13." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يجمع التطبيق أي معلومات من أي شخص، بما في ذلك الأطفال دون سن ١٣ عامًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikace neshromažďuje žádné údaje od nikoho, včetně dětí mladších 13 let."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appen indsamler ingen oplysninger fra nogen, heller ikke børn under 13 år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die App erfasst keinerlei Daten, auch nicht von Kindern unter 13 Jahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La app no recopila información de ninguna persona, incluidos los menores de 13 años."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appi ei kerää tietoja keneltäkään, ei myöskään alle 13-vuotiailta lapsilta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’app ne recueille aucune information auprès de quiconque, y compris des enfants de moins de 13 ans."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "היישום אינו אוסף מידע מאף אדם, לרבות ילדים מתחת לגיל 13."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऐप किसी से भी कोई जानकारी इकट्ठा नहीं करता, जिसमें 13 साल से कम उम्र के बच्चे भी शामिल हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Az app senkitől nem gyűjt adatokat, beleértve a 13 év alatti gyermekeket is."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
