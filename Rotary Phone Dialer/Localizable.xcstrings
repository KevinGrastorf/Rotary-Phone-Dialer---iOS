    "Calling is unavailable on this device. Try again on an iPhone with the Phone app configured." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الاتصال غير متاح على هذا الجهاز. يرجى المحاولة مجددًا على iPhone تم إعداد تطبيق الهاتف عليه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na tomto zařízení nelze volat. Zkuste to znovu na iPhonu s nastavenou aplikací Telefon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opkald er ikke tilgængeligt på denne enhed. Prøv igen på en iPhone, hvor appen Telefon er indstillet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Auf diesem Gerät sind keine Anrufe möglich. Versuche es erneut auf einem iPhone, auf dem die Telefon-App eingerichtet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se pueden hacer llamadas en este dispositivo. Inténtalo de nuevo en un iPhone que tenga configurada la app Teléfono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tällä laitteella ei voi soittaa. Yritä uudelleen iPhonella, jossa Puhelin-appi on otettu käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il est impossible de passer un appel sur cet appareil. Réessayez sur un iPhone sur lequel Téléphone est configuré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "לא ניתן לבצע שיחות במכשיר הזה. יש לנסות שוב ב‑iPhone שבו היישום ״טלפון״ מוגדר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "इस डिवाइस पर कॉल नहीं की जा सकती। फ़ोन ऐप सेट अप किए हुए iPhone पर फिर से कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ezen az eszközön nem lehet hívást indítani. Próbálja újra egy olyan iPhone-on, amelyen be van állítva a Telefon app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le chiamate non sono disponibili su questo dispositivo. Riprova su un iPhone con l’app Telefono configurata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このデバイスでは電話をかけられません。“電話”が設定されているiPhoneでやり直してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이 기기에서는 전화를 걸 수 없습니다. 전화 앱이 설정된 iPhone에서 다시 시도하십시오."
          }
        },
