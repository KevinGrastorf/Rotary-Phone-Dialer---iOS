            "value" : "• אינו שולח נתונים אלינו או לשרת כלשהו"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• हमें या किसी सर्वर को कोई डेटा भेजना"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Nem küld adatokat nekünk vagy bármely szerverre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Inviare dati a noi o a qualsiasi server"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• 当方またはいずれかのサーバへのデータ送信"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• 당사 또는 서버로 데이터 전송"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Menghantar sebarang data kepada kami atau mana-mana pelayan"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Sende data til oss eller til en server"
          }
        },
        "nl" : {
          "stringUnit" : {
