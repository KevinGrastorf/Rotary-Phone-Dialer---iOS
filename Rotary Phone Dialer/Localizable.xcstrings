    "• Collect your name, email, phone number, location, or any other personal information" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• جمع اسمك أو عنوان بريدك الإلكتروني أو رقم هاتفك أو موقعك أو أي معلومات شخصية أخرى"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Neshromažďuje vaše jméno, e-mailovou adresu, telefonní číslo, polohu ani žádné jiné osobní údaje"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Indsamle dit navn, din e-mailadresse, dit telefonnummer, din lokalitet eller andre personlige oplysninger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Name, E-Mail-Adresse, Telefonnummer, Standort oder andere personenbezogene Daten erfassen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• recopila tu nombre, dirección de correo electrónico, número de teléfono, ubicación ni ningún otro dato personal"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Ei kerää nimeäsi, sähköpostiosoitettasi, puhelinnumeroasi, sijaintiasi tai muita henkilötietoja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• recueillir votre nom, votre adresse e-mail, votre numéro de téléphone, votre position ou toute autre information personnelle"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• אינו אוסף את השם, כתובת הדוא״ל, מספר הטלפון, המיקום או מידע אישי אחר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• आपका नाम, ईमेल पता, फ़ोन नंबर, लोकेशन या कोई अन्य निजी जानकारी इकट्ठा करना"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Nem gyűjti a nevét, e-mail-címét, telefonszámát, helyzetét vagy más személyes adatát"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Raccogliere il nome, l’indirizzo email, il numero di telefono, la posizione o qualsiasi altra informazione personale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• 氏名、メールアドレス、電話番号、位置情報、その他の個人情報の収集"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• 이름, 이메일, 전화번호, 위치 또는 기타 개인정보 수집"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Mengumpulkan nama, e-mel, nombor telefon, lokasi atau sebarang maklumat peribadi anda yang lain"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Samle inn navnet, e-postadressen, telefonnummeret, posisjonen eller andre personopplysninger"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Je naam, e-mailadres, telefoonnummer, locatie of andere persoonlijke informatie verzamelen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Nie zbiera imienia i nazwiska, adresu e-mail, numeru telefonu, lokalizacji ani żadnych innych danych osobowych"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• coletar seu nome, endereço de e-mail, número de telefone, localização ou qualquer outra informação pessoal"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• recolhe o nome, o endereço de e-mail, o número de telefone, a localização ou quaisquer outras informações pessoais;"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Nu colectează numele, adresa de e-mail, numărul de telefon, localizarea sau alte informații cu caracter personal"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• собирает имя, адрес электронной почты, номер телефона, данные о местоположении и другую личную информацию;"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Nezhromažďuje vaše meno, e-mail, telefónne číslo, polohu ani iné osobné údaje"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Samla in ditt namn, din e-postadress, ditt telefonnummer, din plats eller andra personuppgifter"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• உங்கள் பெயர், மின்னஞ்சல், தொலைபேசி எண், இருப்பிடம் அல்லது வேறு எந்தத் தனிப்பட்ட தகவலையும் சேகரித்தல்"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• เก็บรวบรวมชื่อ อีเมล หมายเลขโทรศัพท์ ตำแหน่งที่ตั้ง หรือข้อมูลส่วนบุคคลอื่นๆ ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Adınızı, e-posta adresinizi, telefon numaranızı, konumunuzu veya başka bir kişisel bilginizi toplamak"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Збирати імʼя, адресу електронної пошти, номер телефону, геопозицію чи будь-яку іншу особисту інформацію"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Thu thập tên, địa chỉ email, số điện thoại, vị trí hoặc bất kỳ thông tin cá nhân nào khác của bạn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• 收集你的姓名、电子邮件地址、电话号码、位置信息或任何其他个人信息"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• 收集你的姓名、電子郵件地址、電話號碼、位置或任何其他個人資訊"
          }
        }
      }
    },
    "• Send any data to us or to any server" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• إرسال أي بيانات إلينا أو إلى أي خادم"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Odesílat nám nebo na jakýkoli server jakákoli data"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Sende data til os eller til en server"
          }
        },
