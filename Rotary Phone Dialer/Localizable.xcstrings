    "Numbers you dial exist only for the moment it takes to pass them to your Phone app. Nothing is saved on your device or anywhere else." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد الأرقام التي تطلبها إلا خلال الوقت اللازم لتمريرها إلى تطبيق الهاتف. ولا يُحفظ أي شيء على جهازك أو في أي مكان آخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vytočená čísla existují pouze po dobu, kdy jsou předávána aplikaci Telefon. Nic se neukládá do zařízení ani jinam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De numre, du ringer til, findes kun, mens de overføres til appen Telefon. Intet gemmes på enheden eller andre steder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die gewählten Nummern existieren nur so lange, wie sie an die Telefon-App übergeben werden. Weder auf deinem Gerät noch an einem anderen Ort wird etwas gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los números que marcas solo existen durante el instante necesario para pasarlos a la app Teléfono. No se guarda nada en el dispositivo ni en ningún otro lugar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Valitsemasi numerot ovat olemassa vain sen ajan, joka kuluu niiden siirtämiseen Puhelin-appiin. Mitään ei tallenneta laitteeseen tai muualle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les numéros que vous composez n’existent que le temps de les transmettre à Téléphone. Rien n’est enregistré sur votre appareil ni ailleurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "המספרים שמחייגים קיימים רק במשך הזמן הדרוש להעבירם ליישום טלפון. דבר אינו נשמר במכשיר או במקום אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "आपके डायल किए गए नंबर केवल उतनी देर तक मौजूद रहते हैं, जितनी देर उन्हें फ़ोन App को भेजने में लगती है। आपके डिवाइस या कहीं और कुछ भी सहेजा नहीं जाता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A tárcsázott számok csak addig léteznek, amíg átadásra kerülnek a Telefon appnak. Semmi sem kerül mentésre az eszközön vagy máshol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I numeri composti esistono solo per il tempo necessario a passarli all’app Telefono. Non viene salvato nulla sul dispositivo né altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ダイヤルした番号は、“電話”に渡す間だけ存在します。デバイスにもほかの場所にも保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "사용자가 누른 번호는 Phone 앱으로 전달되는 동안에만 존재합니다. 기기나 그 밖의 어디에도 저장되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nombor yang anda dail hanya wujud selama masa yang diperlukan untuk dihantar kepada app Telefon anda. Tiada apa-apa yang disimpan pada peranti anda atau di mana-mana tempat lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Numrene du ringer, finnes bare mens de overføres til Telefon-appen. Ingenting lagres på enheten eller andre steder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nummers die je kiest, bestaan alleen zolang ze aan de Telefoon-app worden doorgegeven. Er wordt niets bewaard op je apparaat of ergens anders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wybierane numery istnieją tylko przez czas potrzebny na przekazanie ich do aplikacji Telefon. Nic nie jest zapisywane na urządzeniu ani w żadnym innym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os números que você disca existem somente durante o tempo necessário para enviá-los ao app Telefone. Nada é salvo no dispositivo nem em qualquer outro lugar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os números marcados só existem durante o tempo necessário para serem transferidos para a app Telefone. Nada é guardado no dispositivo nem em qualquer outro local."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Numerele formate există doar pe durata necesară transmiterii lor către aplicația Telefon. Nu se salvează nimic pe dispozitiv sau în altă parte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Набранные номера существуют лишь в течение времени, необходимого для передачи в приложение «Телефон». Они не сохраняются ни на устройстве, ни где-либо еще."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vytočené čísla existujú iba počas odovzdávania apke Telefón. V zariadení ani nikde inde sa nič neukladá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nummer du slår finns bara under den tid det tar att överföra dem till appen Telefon. Inget sparas på enheten eller någon annanstans."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "நீங்கள் டயல் செய்யும் எண்கள் உங்கள் ஃபோன் செயலிக்கு அனுப்பப்படும் நேரம் வரை மட்டுமே இருக்கும். உங்கள் சாதனத்திலோ வேறெங்குமோ எதுவும் சேமிக்கப்படாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "หมายเลขที่คุณหมุนจะอยู่เพียงชั่วขณะที่ส่งต่อไปยังแอปโทรศัพท์เท่านั้น โดยจะไม่มีการบันทึกข้อมูลในอุปกรณ์หรือที่อื่นใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Çevirdiğiniz numaralar yalnızca Phone uygulamasına aktarılmaları için gereken süre boyunca var olur. Aygıtınıza veya başka bir yere hiçbir şey kaydedilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Набрані номери існують лише протягом часу, потрібного для їх передавання до програми «Телефон». Нічого не зберігається на пристрої чи деінде."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Các số bạn quay chỉ tồn tại trong khoảng thời gian cần thiết để chuyển sang ứng dụng Điện thoại. Không có nội dung nào được lưu trên thiết bị của bạn hoặc ở bất kỳ nơi nào khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你拨打的号码仅在传递给“电话”App 的短暂过程中存在。设备或其他任何地方都不会保存这些号码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你撥打的號碼只會在傳遞至「電話」App的短暫過程中存在。裝置或其他任何地方都不會儲存這些號碼。"
          }
        }
      }
    },
