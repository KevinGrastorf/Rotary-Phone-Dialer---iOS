    },
    "The app requests no device permissions. It does not access your microphone, camera, location, photos, or storage, and it cannot read your contact list." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا يطلب التطبيق أي أذونات من الجهاز. ولا يصل إلى الميكروفون أو الكاميرا أو الموقع أو الصور أو مساحة التخزين، ولا يمكنه قراءة قائمة جهات الاتصال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikace nevyžaduje žádná oprávnění zařízení. Nemá přístup k mikrofonu, fotoaparátu, poloze, fotografiím ani úložišti a nemůže číst váš seznam kontaktů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appen anmoder ikke om nogen enhedstilladelser. Den har ikke adgang til mikrofon, kamera, lokalitet, fotos eller lagringsplads og kan ikke læse kontaktlisten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die App fordert keine Geräteberechtigungen an. Sie greift nicht auf dein Mikrofon, deine Kamera, deinen Standort, deine Fotos oder deinen Speicher zu und kann deine Kontaktliste nicht lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La app no solicita permisos del dispositivo. No accede al micrófono, la cámara, la ubicación, las fotos ni el almacenamiento, y no puede leer la lista de contactos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appi ei pyydä laitteen käyttöoikeuksia. Se ei käytä mikrofonia, kameraa, sijaintia, kuvia tai tallennustilaa eikä voi lukea yhteystietoluetteloa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’app ne demande aucune autorisation sur l’appareil. Elle n’accède ni à votre microphone, ni à votre appareil photo, ni à votre position, ni à vos photos, ni à votre stockage, et elle ne peut pas lire votre liste de contacts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "היישום אינו מבקש הרשאות למכשיר. הוא אינו ניגש למיקרופון, למצלמה, למיקום, לתמונות או לאחסון, ואינו יכול לקרוא את רשימת אנשי הקשר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऐप डिवाइस से जुड़ी कोई अनुमति नहीं माँगता। यह आपके माइक्रोफ़ोन, कैमरे, लोकेशन, फ़ोटो या स्टोरेज को ऐक्सेस नहीं करता और आपकी कॉन्टैक्ट सूची को पढ़ नहीं सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Az app nem kér eszközengedélyeket. Nem fér hozzá a mikrofonhoz, a kamerához, a helyzethez, a fotókhoz vagy a tárhelyhez, és nem tudja olvasni a kontaktlistát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’app non richiede autorizzazioni del dispositivo. Non accede al microfono, alla fotocamera, alla posizione, alle foto o allo spazio di archiviazione e non può leggere l’elenco dei contatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このアプリはデバイスのアクセス許可を一切求めません。マイク、カメラ、位置情報、写真、ストレージにアクセスせず、連絡先リストを読み取ることもできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "앱은 어떠한 기기 권한도 요청하지 않습니다. 마이크, 카메라, 위치, 사진 또는 저장 공간에 접근하지 않으며, 연락처 목록을 읽을 수도 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "App tidak meminta sebarang keizinan peranti. App tidak mengakses mikrofon, kamera, lokasi, foto atau storan anda dan tidak dapat membaca senarai kenalan anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appen ber ikke om noen enhetstillatelser. Den har ikke tilgang til mikrofonen, kameraet, posisjonen, bildene eller lagringsplassen, og den kan ikke lese kontaktlisten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De app vraagt geen apparaattoestemmingen. De app heeft geen toegang tot je microfoon, camera, locatie, foto’s of opslag en kan je contactenlijst niet lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikacja nie prosi o żadne uprawnienia urządzenia. Nie uzyskuje dostępu do mikrofonu, aparatu, lokalizacji, zdjęć ani pamięci masowej i nie może odczytać listy kontaktów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O app não solicita nenhuma permissão do dispositivo. Ele não acessa microfone, câmera, localização, fotos ou armazenamento e não consegue ler a lista de contatos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A app não solicita permissões do dispositivo. Não acede ao microfone, à câmara, à localização, às fotografias nem ao armazenamento e não consegue ler a lista de contactos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplicația nu solicită permisiuni pentru dispozitiv. Nu accesează microfonul, camera, localizarea, pozele sau spațiul de stocare și nu poate citi lista de contacte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Приложение не запрашивает разрешений устройства. Оно не получает доступ к микрофону, камере, геопозиции, фотографиям или хранилищу и не может читать список контактов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apka nežiada žiadne povolenia zariadenia. Nemá prístup k mikrofónu, kamere, polohe, fotkám ani úložisku a nedokáže čítať zoznam kontaktov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appen begär inga behörigheter på enheten. Den har inte åtkomst till mikrofon, kamera, plats, bilder eller lagring och kan inte läsa din kontaktlista."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "செயலி எந்தச் சாதன அனுமதியையும் கோருவதில்லை. உங்கள் மைக்ரோஃபோன், கேமரா, இருப்பிடம், புகைப்படங்கள் அல்லது சேமிப்பகத்தை அது அணுகுவதில்லை. உங்கள் தொடர்புப் பட்டியலையும் அதனால் படிக்க முடியாது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "แอปไม่ขอสิทธิ์อนุญาตใดๆ ของอุปกรณ์ แอปจะไม่เข้าถึงไมโครโฟน กล้อง ตำแหน่งที่ตั้ง รูปภาพ หรือพื้นที่จัดเก็บ และไม่สามารถอ่านรายชื่อของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Uygulama hiçbir aygıt izni istemez. Mikrofonunuza, kameranıza, konumunuza, fotoğraflarınıza veya saklama alanınıza erişmez ve kişi listenizi okuyamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Програма не запитує жодних дозволів пристрою. Вона не має доступу до мікрофона, камери, геопозиції, фотографій чи сховища й не може читати список контактів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ứng dụng không yêu cầu bất kỳ quyền nào trên thiết bị. Ứng dụng không truy cập micrô, camera, vị trí, ảnh hoặc bộ nhớ của bạn và không thể đọc danh sách liên hệ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "本 App 不会请求任何设备权限。它不会访问你的麦克风、相机、位置信息、照片或存储空间，也无法读取你的联系人列表。"
          }
        },
        "zh-Hant" : {
