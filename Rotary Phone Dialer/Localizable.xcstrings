            "value" : "• Neposiela žiadne údaje nám ani na žiadny server"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Skicka data till oss eller till någon server"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• எங்களுக்கோ எந்தச் சேவையகத்திற்கோ தரவை அனுப்புதல்"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• ส่งข้อมูลใดๆ ให้เราหรือเซิร์ฟเวอร์ใดๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Bize veya herhangi bir sunucuya veri göndermek"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Надсилати будь-які дані нам або на будь-який сервер"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "• Gửi bất kỳ dữ liệu nào cho chúng tôi hoặc đến bất kỳ máy chủ nào"
          }
        },
        "zh-Hans" : {
