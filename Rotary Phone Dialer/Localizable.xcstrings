    "Enter the three-digit area code to print on the center card." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يرجى إدخال رمز المنطقة المكوّن من ثلاثة أرقام لعرضه على البطاقة الوسطى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zadejte trojcifernou předvolbu, která se zobrazí na kartě uprostřed."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Indtast det trecifrede områdenummer, der skal udskrives på kortet i midten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gib die dreistellige Vorwahl ein, die auf der mittleren Karte erscheinen soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Introduce el código de área de tres dígitos que se mostrará en la tarjeta central."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Syötä keskikorttiin tulostettava kolminumeroinen suuntanumero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saisissez l’indicatif régional à trois chiffres à imprimer sur la carte centrale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "יש להזין את הקידומת בת שלוש הספרות שתודפס על הכרטיס המרכזי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
